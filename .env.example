# 复制为 .env（已被 .gitignore 忽略，永不进仓）
# 默认 Cloudflare R2：到 Cloudflare 控制台建桶后，建一个仅限该桶的 R2 API Token，
# 把 Token 的 Access Key ID / Secret Access Key 填到下面两行，不要贴到聊天或仓里。
OSS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
OSS_BUCKET=
OSS_REGION=auto
OSS_PUBLIC_BASE=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
NOTION_TOKEN=
